{
    "name": "taskify/ai-kit",
    "description": "A universal, .md-based starter kit that transforms any AI coding agent into a disciplined, production-ready Laravel Tech Lead.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Taskify Team",
            "email": "support@taskify.ai"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Taskify\\AIKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Taskify\\AIKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Taskify\\AIKit\\TaskifyServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test",
        "check": [
            "@lint:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
