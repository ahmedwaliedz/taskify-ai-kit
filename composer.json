{
    "name": "taskify/ai-kit",
    "description": "A universal, .md-based starter kit that transforms any AI coding agent into a disciplined, production-ready Laravel Tech Lead.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Taskify Team",
            "email": "support@taskify.ai"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Taskify\\AIKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Taskify\\AIKit\\TaskifyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
